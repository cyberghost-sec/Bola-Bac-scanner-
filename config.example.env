# Copy to config.env, fill in for YOUR LAB ONLY, and load with:
#   set -a; source config.env; set +a
# Never commit a filled-in config.env — it is in .gitignore for a reason.

# Tokens for three test accounts you created in your own lab.
# Tip: create them fresh for each engagement and revoke them afterwards.
export TOKEN_A="alice-jwt-or-session-token"
export TOKEN_B="bob-jwt-or-session-token"
export TOKEN_LOW="bob-jwt-or-session-token"

# Cookie-based apps instead of bearer tokens? Use these and leave TOKEN_* empty:
# export COOKIE_A="session=alice-session"
# export COOKIE_B="session=bob-session"

# Auth customisation
export AUTH_HEADER="Authorization"   # e.g. X-API-Key
export AUTH_SCHEME="Bearer"          # set to "" if the raw token is the whole header value

export DELAY="0.3"
export TIMEOUT="10"
